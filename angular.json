{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-core-ui": {
      "projectType": "library",
      "root": "projects/ng-core-ui",
      "sourceRoot": "projects/ng-core-ui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-core-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-core-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ng-core-ui/tsconfig.spec.json",
            "karmaConfig": "projects/ng-core-ui/karma.conf.js",
            "styles": [
              "projects/ng-core-ui/styles/components.css"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-core-ui/**/*.ts",
              "projects/ng-core-ui/**/*.html"
            ],
            "eslintConfig": "projects/ng-core-ui/eslint.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
